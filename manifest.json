{
  "manifest_version": 3,
  "name": "Seenly — Gmail Tracker",
  "version": "1.0.0",
  "description": "Seenly is a Gmail tracker. Connect your account and see whether someone saw a mail you sent.",
  "key": "",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_title": "Seenly — Gmail Tracker",
    "default_popup": "extension/popup.html",
    "default_icon": {
      "16": "extension/icons/icon16.png",
      "48": "extension/icons/icon48.png",
      "128": "extension/icons/icon128.png"
    }
  },
  "icons": {
    "16": "extension/icons/icon16.png",
    "48": "extension/icons/icon48.png",
    "128": "extension/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["extension/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
